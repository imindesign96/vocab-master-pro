rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Legacy: word list
      match /words/{wordId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Legacy: stats/data
      match /data/{document} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // New: Anki-style decks
      match /decks/{deckId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // New: Anki-style cards
      match /cards/{cardId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // New: stats summary
      match /stats/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
